        <mxCell id="S2F7ceKrvcb2F1dxYILS-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" value="&lt;font style=&quot;font-size: 27px;&quot;&gt;&lt;b&gt;NON FUNCTIONAL REQUIREMENT&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 27px;&quot;&gt;1. &lt;/font&gt;&lt;span style=&quot;background-color: transparent; font-size: 27px;&quot;&gt;Low latency response time&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 27px;&quot;&gt;2.High availability (99.9% uptime)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; font-size: 27px;&quot;&gt;3.Scalability to support millions of concurrent users &lt;br&gt;4.Strong consistency for inventory and payments &lt;br&gt;5.Secure handling of user and payment data&lt;/span&gt;&lt;/div&gt;" vertex="1">
